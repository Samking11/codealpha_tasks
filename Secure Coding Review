Fixed Version (`secure_app.py`)

```python
import subprocess
import hashlib

def login(user_input_password):
    stored_password_hash = hashlib.sha256("securepassword".encode()).hexdigest()
    input_password_hash = hashlib.sha256(user_input_password.encode()).hexdigest()
    if input_password_hash == stored_password_hash:
        print("Login successful!")
    else:
        print("Access denied.")

def run_command(cmd):
    safe_commands = ["ls", "pwd", "whoami"]
    if cmd in safe_commands:
        subprocess.run([cmd])
    else:
        print("Command not allowed.")

user_input = input("Enter command: ")
run_command(user_input)
```

